package corpus

import (
	"context"

	"github.com/opensearch-project/opensearch-go/v4/opensearchapi"
)

// holder keeps the API client and context for files that import neither.
type holder struct {
	ctx context.Context
	c   *opensearchapi.Client
}
-- templatemarker.go --
// SPDX-License-Identifier: Apache-2.0
//
// The OpenSearch Contributors require contributions made to
// this file be licensed under the Apache-2.0 license or a
// compatible open source license.

package corpus

import (
	"context"

	"github.com/opensearch-project/opensearch-go/v4/opensearchapi"
)

// templateMarker passes a *Req variable to a method that takes a Req in v5: the
// variable may be nil, so the dereference is left to a human and a compile-time
// marker plants the spot. The bare sub-client read has no mechanical target and
// is reported MANUAL.
func templateMarker(ctx context.Context, c *opensearchapi.Client, req *opensearchapi.IndexTemplateGetReq) {
	_, _ = c.IndexTemplate.Get(ctx, req)
	_ = c.IndexTemplate
}
-- templates.go.golden --
// SPDX-License-Identifier: Apache-2.0
//
// The OpenSearch Contributors require contributions made to
