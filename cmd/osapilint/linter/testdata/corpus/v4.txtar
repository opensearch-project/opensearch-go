package corpus

import api "github.com/opensearch-project/opensearch-go/v5/opensearchapi"

// catResponses exercises value and pointer selectors, keyed literals, and an
// aliased import. Identically named fields on unrelated types must stay put.
func catResponses(shards api.CatShardsResp, indices *api.CatIndicesResp) int {
	emptyShards := api.CatShardsResp{Records: nil}
	emptyIndices := &api.CatIndicesResp{Records: nil}
	other := struct{ Shards, Indices int }{Shards: 1, Indices: 2}
	for _, index := range indices.Records {
		if index.Health == "green" {
			_ = index.Index
			_ = index.Primary
		}
	}
	for _, shard := range shards.Records {
		_ = shard.Prirep
	}
	return len(shards.Records) + len(indices.Records) + len(emptyShards.Records) + len(emptyIndices.Records) + other.Shards + other.Indices
}
