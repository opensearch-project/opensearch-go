package corpus

import (
	"github.com/opensearch-project/opensearch-go/v4"
	"github.com/opensearch-project/opensearch-go/v4/opensearchapi"
)

// newFromClient calls NewFromClient, which v5 removes with no mechanical
// replacement: the hop reports it MANUAL and leaves the call in place.
func newFromClient(c *opensearch.Client) *opensearchapi.Client {
	return opensearchapi.NewFromClient(c)
}
-- catresponses.go --
// SPDX-License-Identifier: Apache-2.0
//
// The OpenSearch Contributors require contributions made to
// this file be licensed under the Apache-2.0 license or a
// compatible open source license.

package corpus

import api "github.com/opensearch-project/opensearch-go/v4/opensearchapi"

// catResponses exercises value and pointer selectors, keyed literals, and an
// aliased import. Identically named fields on unrelated types must stay put.
func catResponses(shards api.CatShardsResp, indices *api.CatIndicesResp) int {
	emptyShards := api.CatShardsResp{Shards: nil}
	emptyIndices := &api.CatIndicesResp{Indices: nil}
	other := struct{ Shards, Indices int }{Shards: 1, Indices: 2}
	for _, index := range indices.Indices {
		if index.Health == "green" {
			_ = index.Index
			_ = index.Primary
		}
	}
	for _, shard := range shards.Shards {
		_ = shard.Prirep
	}
	return len(shards.Shards) + len(indices.Indices) + len(emptyShards.Shards) + len(emptyIndices.Indices) + other.Shards + other.Indices
}
-- catresponses.go.golden --
// SPDX-License-Identifier: Apache-2.0
