// compatible open source license.

package corpus

// noImport passes nil to a *Req parameter in a file with no imports at all: the
// empty Req it becomes needs the v5 import added.
func noImport(h holder) {
	_, _ = h.c.IndexTemplate.Get(h.ctx, nil)
}
