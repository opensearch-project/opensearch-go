-- plugins.go --
// SPDX-License-Identifier: Apache-2.0
//
// The OpenSearch Contributors require contributions made to
// this file be licensed under the Apache-2.0 license or a
// compatible open source license.

package corpus

import (
	"github.com/opensearch-project/opensearch-go/v4/plugins/ism"
	"github.com/opensearch-project/opensearch-go/v4/plugins/security"
)

// plugins uses the plugin Config types and sub-client fields v5 removes or
// regroups. The hop reports them MANUAL and leaves the code in place.
func plugins() error {
	sec, err := security.NewClient(security.Config{})
	if err != nil {
		return err
	}
	_ = sec.Roles

	pol, err := ism.NewClient(ism.Config{})
	if err != nil {
		return err
	}
	_ = pol.Policies
	return nil
}
