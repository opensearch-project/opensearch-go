// compatible open source license.

package corpus

import (
	"context"

	osapi "github.com/opensearch-project/opensearch-go/v5/opensearchapi"
)

// templates exercises the sub-client regroups, one per argument shape, through
// an aliased import. Create takes a Req in both versions. Get took a *Req in v4
// and takes a Req in v5: nil becomes an empty Req, &Req{...} and &x lose the &.
// Template.Exists took a Req and takes a *Req. Script.Get regroups to the top
// level. The Name and ID renames and the Params wrap apply inside the literals.
func templates(ctx context.Context, c *osapi.Client) {
	_, _ = c.Indices.PutIndexTemplate(ctx, osapi.IndicesPutIndexTemplateReq{Name: "t", Params: &osapi.IndicesPutIndexTemplateParams{}})
	_, _ = c.Indices.GetIndexTemplate(ctx, osapi.IndicesGetIndexTemplateReq{})
	_, _ = c.Indices.GetIndexTemplate(ctx, osapi.IndicesGetIndexTemplateReq{Name: "t"})
	req := osapi.IndicesGetIndexTemplateReq{}
	_, _ = c.Indices.GetIndexTemplate(ctx, req)
	_, _ = c.Indices.ExistsTemplate(ctx, &osapi.IndicesExistsTemplateReq{})
	_, _ = c.GetScript(ctx, osapi.GetScriptReq{ID: "s"})
}
-- templatemarker.go.golden --
// SPDX-License-Identifier: Apache-2.0
//
