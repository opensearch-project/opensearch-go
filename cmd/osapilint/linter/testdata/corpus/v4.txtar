package corpus

import (
	"strings"

	"github.com/opensearch-project/opensearch-go/v5/opensearchapi"
)

// restoreReq: v5 gives SnapshotRestoreReq a typed Body and keeps the raw
// io.Reader as BodyReader, so the reader moves there (and Repo is renamed).
func restoreReq() opensearchapi.SnapshotRestoreReq {
	return opensearchapi.SnapshotRestoreReq{Repository: "r", Snapshot: "s", BodyReader: strings.NewReader(`{}`)}
}

// searchReq: v5 Params is a *SearchParams. A literal value gains &; any other
// value becomes new(x), a pointer to a copy like the v4 value semantics.
func searchReq(p opensearchapi.SearchParams) []opensearchapi.SearchReq {
	return []opensearchapi.SearchReq{
		{Params: &opensearchapi.SearchParams{}},
		{Params: new(p)},
	}
}
-- retype.go --
// SPDX-License-Identifier: Apache-2.0
//
// The OpenSearch Contributors require contributions made to
// this file be licensed under the Apache-2.0 license or a
// compatible open source license.

package corpus

import "github.com/opensearch-project/opensearch-go/v4/opensearchapi"

// hit: v5 retypes SearchHit.Score from float32 to *float64, so neither & nor
// new(x) fits and the key stays put, reported MANUAL. Index only became a
// *string, so its constant moves into new(x).
func hit() opensearchapi.SearchHit {
	return opensearchapi.SearchHit{Index: "i", Score: 1.5}
}

// counts: v5 makes the int64 counters *int64. A variable of the field's type
// moves into new(x); the constant 1 would make new(1) an *int, so it is
// reported MANUAL instead.
func counts(n int64) opensearchapi.BulkByScrollTaskStatus {
	return opensearchapi.BulkByScrollTaskStatus{Created: 1, Updated: n}
}

// score: a read of a retyped field is reported MANUAL too, since float32
// arithmetic or printing on what is now a *float64 breaks or changes behavior.
func score(h opensearchapi.SearchHit) float32 {
	return h.Score
}
