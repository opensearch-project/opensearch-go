package corpus

import (
	"github.com/opensearch-project/opensearch-go/v5/opensearchapi"
)

// importPrune checks the post-rewrite import prune. The aliased root import's
// only use is ToPointer, so it must be dropped by its alias. opensearchapi keeps
// a use after its ToPointer call is rewritten, so it must survive, bumped to v5.
func importPrune() (*int, *bool, opensearchapi.Config) {
