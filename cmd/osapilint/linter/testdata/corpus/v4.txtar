package corpus

import "github.com/opensearch-project/opensearch-go/v5/opensearchapi"

// hit: v5 retypes SearchHit.Score from float32 to *float64, so neither & nor
// new(x) fits and the key stays put, reported MANUAL. Index only became a
// *string, so its constant moves into new(x).
func hit() opensearchapi.SearchHit {
	return opensearchapi.SearchHit{Index: new("i"), Score: 1.5}
}

// counts: v5 makes the int64 counters *int64. A variable of the field's type
// moves into new(x); the constant 1 would make new(1) an *int, so it is
// reported MANUAL instead.
func counts(n int64) opensearchapi.BulkByScrollTaskStatus {
	return opensearchapi.BulkByScrollTaskStatus{Created: 1, Updated: new(n)}
}

// score: a read of a retyped field is reported MANUAL too, since float32
// arithmetic or printing on what is now a *float64 breaks or changes behavior.
func score(h opensearchapi.SearchHit) float32 {
	return h.Score
}
-- templates.go --
// SPDX-License-Identifier: Apache-2.0
//
// The OpenSearch Contributors require contributions made to
// this file be licensed under the Apache-2.0 license or a
// compatible open source license.

package corpus

import (
	"context"

	osapi "github.com/opensearch-project/opensearch-go/v4/opensearchapi"
)

// templates exercises the sub-client regroups, one per argument shape, through
// an aliased import. Create takes a Req in both versions. Get took a *Req in v4
// and takes a Req in v5: nil becomes an empty Req, &Req{...} and &x lose the &.
// Template.Exists took a Req and takes a *Req. Script.Get regroups to the top
// level. The Name and ID renames and the Params wrap apply inside the literals.
func templates(ctx context.Context, c *osapi.Client) {
	_, _ = c.IndexTemplate.Create(ctx, osapi.IndexTemplateCreateReq{IndexTemplate: "t", Params: osapi.IndexTemplateCreateParams{}})
	_, _ = c.IndexTemplate.Get(ctx, nil)
	_, _ = c.IndexTemplate.Get(ctx, &osapi.IndexTemplateGetReq{IndexTemplates: "t"})
	req := osapi.IndexTemplateGetReq{}
	_, _ = c.IndexTemplate.Get(ctx, &req)
	_, _ = c.Template.Exists(ctx, osapi.TemplateExistsReq{})
	_, _ = c.Script.Get(ctx, osapi.ScriptGetReq{ScriptID: "s"})
}
-- templateimport.go --
// SPDX-License-Identifier: Apache-2.0
//
// The OpenSearch Contributors require contributions made to
