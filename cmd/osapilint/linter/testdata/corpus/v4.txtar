// compatible open source license.

package corpus

import (
	"context"

	"github.com/opensearch-project/opensearch-go/v5/opensearchapi"
)

// templateMarker passes a *Req variable to a method that takes a Req in v5: the
// variable may be nil, so the dereference is left to a human and a compile-time
// marker plants the spot. The bare sub-client read has no mechanical target and
// is reported MANUAL.
func templateMarker(ctx context.Context, c *opensearchapi.Client, req *opensearchapi.IndicesGetIndexTemplateReq) {
	_, _ = c.Indices.GetIndexTemplate(ctx, _OSAPILINT_RESOLVE /* OSAPILINT v4->v5 MANUAL: req may be nil -- migrate by hand: client.IndexTemplate.Get took a *Req, client.Indices.GetIndexTemplate takes the Req by value; pass *req once it is non-nil */)
	_ = c.IndexTemplate
}
