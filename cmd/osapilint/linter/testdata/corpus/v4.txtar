-- go.mod --
module osapilintcorpus/v4

go 1.24

require github.com/opensearch-project/opensearch-go/v4 v4.0.0

replace github.com/opensearch-project/opensearch-go/v4 => ../stub-v4
-- removedtype.go --
// SPDX-License-Identifier: Apache-2.0
