-- go.mod --
module osapilintcorpus/v5

go 1.24

require github.com/opensearch-project/opensearch-go/v5 v5.1.0

replace github.com/opensearch-project/opensearch-go/v5 => ../stub-v5
-- minor.go --
// SPDX-License-Identifier: Apache-2.0
//
// The OpenSearch Contributors require contributions made to
// this file be licensed under the Apache-2.0 license or a
// compatible open source license.

package corpus

import "github.com/opensearch-project/opensearch-go/v5/opensearchapi"

// minor exercises the v5 -> v5.2 hop, which keeps the import path: the two
// renamed types, the renamed and removed fields, and a field relocated out of
// the struct, which is reported MANUAL and left in place.
func minor(q opensearchapi.InsightsTopQuery, c opensearchapi.SearchSuggestCompletion, i opensearchapi.RollupsInterval) (int, bool) {
	var hits opensearchapi.MLSearchHits
	_ = q.QueryHashcode
	_ = opensearchapi.AsynchronousSearchRespBody{ID: q.ID, Took: nil}
	return c.Length + len(hits.Hits), i.Cron != nil
}

// lastParam renames a type that ends a parameter list: the renamed identifier
// must keep the closing parenthesis where it was.
func lastParam(c opensearchapi.SearchSuggestCompletion) int { return c.Length }
-- minor.go.golden --
